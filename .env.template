# Local environment variables template
# Copy this file to '.env' and populate with your own values.

# Django Secret Key (keep secure and do not share/commit to version control!)
SECRET_KEY=django-insecure-your-secret-key-here

# Django Debug Mode (True for local development, False for production)
DEBUG=True

# Django Allowed Hosts (comma-separated list of hostnames allowed to access the app)
ALLOWED_HOSTS=localhost,127.0.0.1

